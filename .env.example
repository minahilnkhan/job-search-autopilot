# Copy to .env and fill in. .env is gitignored.

# Used from Phase 2 onward (scoring, tailoring, mentor check-ins).
ANTHROPIC_API_KEY=

# SQLite file path, relative to the repo root.
DATABASE_PATH=data/autopilot.db

# API server port. The web dev server proxies /api to it.
PORT=3001

# The job-search inbox (optional). Read once a day at 8pm, read-only: the app
# never sends, deletes or marks mail read. Use a Google *app password*
# (myaccount.google.com/apppasswords, needs 2-Step Verification), not your
# Google password. Revoke it there any time.
MAIL_ADDRESS=
MAIL_APP_PASSWORD=
# MAIL_IMAP_HOST=imap.gmail.com
